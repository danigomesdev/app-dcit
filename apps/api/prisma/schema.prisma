generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TimeEntry {
  id        String   @id @default(uuid())
  userId    String
  clockedAt DateTime
  createdAt DateTime @default(now())
}

// --- Solicitações ---------------------------------------------------------

model AdjustmentRequest {
  id        String   @id @default(uuid())
  userId    String
  reason    String
  status    String   @default("pendente")
  createdAt DateTime @default(now())
}

model CompensationRequest {
  id        String   @id @default(uuid())
  userId    String
  reason    String
  status    String   @default("pendente")
  createdAt DateTime @default(now())
}

model VacationRequest {
  id        String   @id @default(uuid())
  userId    String
  startDate DateTime
  endDate   DateTime
  days      Int
  status    String   @default("pendente")
  createdAt DateTime @default(now())
}

// HR facts needed to compute the CLT aquisitivo/concessivo vacation cycle
// for a real employee instead of a hardcoded constant. One row per user.
model Employee {
  userId   String   @id
  name     String
  role     String
  hireDate DateTime
}

model VacationHistoryEntry {
  id        String   @id @default(uuid())
  userId    String
  year      Int
  daysTaken Int
  startDate DateTime
  endDate   DateTime
}

// --- Atestados -------------------------------------------------------------

model Atestado {
  id        String   @id @default(uuid())
  userId    String
  userName  String
  cid       String?
  crm       String?
  medico    String?
  dias      Int?
  photoUri  String?
  status    String   @default("enviado")
  createdAt DateTime @default(now())
}

// --- Documentos --------------------------------------------------------

model Certification {
  id          String   @id @default(uuid())
  userId      String
  name        String
  institution String
  validUntil  DateTime
  createdAt   DateTime @default(now())
}

// Covers both RH-seeded historical admission docs (status "aprovado", from
// before the app existed) and new in-app uploads (status "enviado").
model AdmissionDocument {
  id          String   @id @default(uuid())
  userId      String
  title       String
  photoUri    String?
  status      String   @default("enviado")
  submittedAt DateTime @default(now())
}

// No payroll backend exists — seeded illustrative payslips per user, served
// from the API instead of hardcoded in the app so at least the integration
// pattern (auth-guarded fetch, not a bundled const) is real.
model Payslip {
  id       String @id @default(uuid())
  userId   String
  label    String
  gross    Float
  inss     Float
  irrf     Float
  benefits Float
}

// --- Mural -----------------------------------------------------------------

model MuralPost {
  id        String   @id @default(uuid())
  glyph     String
  title     String
  body      String
  createdAt DateTime @default(now())
}

model MuralReaction {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Birthday {
  name  String
  day   Int
  month Int

  @@id([name])
}

// --- Benefícios / Onboarding -----------------------------------------------

model BenefitBalance {
  id            String @id @default(uuid())
  userId        String
  icon          String
  label         String
  balance       Float
  monthlyCredit Float
}

model Partner {
  id       String @id @default(uuid())
  name     String
  category String
  discount String
}

model OnboardingTask {
  id          String @id @default(uuid())
  icon        String
  title       String
  description String
  order       Int
}

model OnboardingProgress {
  id          String   @id @default(uuid())
  userId      String
  taskId      String
  completedAt DateTime @default(now())

  @@unique([userId, taskId])
}

// --- Operacional / TI --------------------------------------------------

model SobreavisoRecord {
  id        String    @id @default(uuid())
  userId    String
  startedAt DateTime
  endedAt   DateTime?
}

model DeslocamentoRecord {
  id        String   @id @default(uuid())
  userId    String
  startedAt DateTime
  endedAt   DateTime
}

// --- Push notifications ------------------------------------------------

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())
}
